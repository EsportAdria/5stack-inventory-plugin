<Project Sdk="Microsoft.NET.Sdk">

  <!-- VRF from master: the released 19.x cannot read the VCS 72 files CS2 ships.
       Clone it next to this tool (see README.md) or point VRF_DIR at a checkout. -->
  <PropertyGroup>
    <VRF_DIR Condition="'$(VRF_DIR)' == ''">$(MSBuildThisFileDirectory)vrf</VRF_DIR>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(VRF_DIR)/ValveResourceFormat/ValveResourceFormat.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
